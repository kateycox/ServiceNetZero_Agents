# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/foodservice_db
REDIS_URL=redis://localhost:6379/0

# Service Ports
MACHINE1_PORT=8001
MACHINE2_PORT=8002
MACHINE3_PORT=8003
MACHINE4_PORT=8004
MACHINE5_PORT=8005
MACHINE6_PORT=8006
API_GATEWAY_PORT=8000

# API Keys (for external integrations)
SYSCO_API_KEY=your_sysco_api_key
INVENTORY_SYSTEM_API_KEY=your_inventory_api_key
POS_SYSTEM_API_KEY=your_pos_api_key
ACCOUNTING_SYSTEM_API_KEY=your_accounting_api_key
CATERING_SYSTEM_API_KEY=your_catering_api_key

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng

# Machine Learning Models
ML_MODEL_PATH=/workspace/models

# Carbon Footprint API (optional external service)
CARBON_API_KEY=your_carbon_api_key

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
